# Supabase PostgreSQL Connection Strings
# Transaction pooler URL (port 6543) for Serverless/Next.js
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Master API Key for Android and authorized clients
API_KEY="your-secure-random-master-api-key"

# Bank Account / Card Configuration
ACCOUNT_NUMBER="your-bank-account-or-card-number"

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Web Dashboard Master Password (hashed or secret for single user)
MASTER_PASSWORD="your-strong-dashboard-password"

# Optional: Host URL for Webhooks
APP_URL="https://your-txteller-app.vercel.app"
